---
// Общий каркас сайта Вали: <head> + Метрика + шапка + подвал. Мультиязык: RU (корень) / EN (/en) / ES (/es).
// lang по умолчанию 'ru' → строки = текущие русские (обратная совместимость).
const {
  title, description, keywords, canonical,
  ogType = 'website', ogTitle, ogDescription, twTitle, twDescription,
  cms = false,
  robots = 'index, follow, max-image-preview:large',
  lang = 'ru',
  altPath = '',   // имя файла без локали: 'about.html', 'course.html'… пусто = главная
  i18n = false,   // true только на переведённых страницах → показать переключатель языков + hreflang
} = Astro.props;

const ogUrl = canonical;
const ogT = ogTitle ?? title;
const ogD = ogDescription ?? description;
const twT = twTitle ?? title;
const twD = twDescription ?? description;

// строки шапки/подвала по языку
const STR = {
  ru: { b1: 'Отношения', b2: 'длиною в жизнь', about: 'Обо мне', course: 'Курс', tests: 'Тесты', free: 'Бесплатное', freeBtn: 'Бесплатный тест',
    tag: 'Живая реальность вместо красивой обёртки из соцсетей. И живая ты.',
    sec: 'Разделы', cAbout: 'Обо мне — моя история', cCourse: 'Курс «Отношения длиною в жизнь»', cTests: 'Бесплатные тесты', cBlog: 'Блог про отношения',
    con: 'Связь', cTg: 'Написать в Telegram', cBot: 'Бот-помощница в Telegram', cPdf: 'Получить PDF-гайд', cPrices: 'Тарифы курса', offer: 'Оферта', privacy: 'Политика конфиденциальности', locale: 'ru_RU' },
  en: { b1: 'Relationships', b2: 'for a lifetime', about: 'About', course: 'Course', tests: 'Tests', free: 'Free', freeBtn: 'Free test',
    tag: 'Real life instead of a pretty social-media wrapper. And the real you.',
    sec: 'Sections', cAbout: 'About — my story', cCourse: 'Course «Relationships for a Lifetime»', cTests: 'Free tests', cBlog: 'Relationship blog',
    con: 'Contact', cTg: 'Message on Telegram', cBot: 'AI assistant on Telegram', cPdf: 'Get the PDF guide', cPrices: 'Course pricing', offer: 'Terms', privacy: 'Privacy Policy', locale: 'en_US' },
  es: { b1: 'Relaciones', b2: 'para toda la vida', about: 'Sobre mí', course: 'Curso', tests: 'Tests', free: 'Gratis', freeBtn: 'Test gratis',
    tag: 'La vida real en lugar de un bonito envoltorio de redes. Y la verdadera tú.',
    sec: 'Secciones', cAbout: 'Sobre mí — mi historia', cCourse: 'Curso «Relaciones para toda la vida»', cTests: 'Tests gratis', cBlog: 'Blog de relaciones',
    con: 'Contacto', cTg: 'Escribir por Telegram', cBot: 'Asistente IA en Telegram', cPdf: 'Recibir la guía PDF', cPrices: 'Precios del curso', offer: 'Términos', privacy: 'Política de privacidad', locale: 'es_ES' },
};
const T = STR[lang] || STR.ru;
const base = lang === 'ru' ? '' : '/' + lang;
const home = lang === 'ru' ? '/' : base + '.html';
const L = (p) => base + '/' + p;
const SITE = 'https://ageeva.win';
const altRu = altPath ? '/' + altPath : '/';
const altEn = altPath ? '/en/' + altPath : '/en.html';
const altEs = altPath ? '/es/' + altPath : '/es.html';

const METRIKA = `(function(m,e,t,r,i,k,a){
        m[i]=m[i]||function(){(m[i].a=m[i].a||[]).push(arguments)};
        m[i].l=1*new Date();
        for (var j = 0; j < document.scripts.length; j++) {if (document.scripts[j].src === r) { return; }}
        k=e.createElement(t),a=e.getElementsByTagName(t)[0],k.async=1,k.src=r,a.parentNode.insertBefore(k,a)
    })(window, document,'script','https://mc.yandex.ru/metrika/tag.js?id=109819083', 'ym');

    ym(109819083, 'init', {ssr:true, webvisor:true, clickmap:true, ecommerce:"dataLayer", referrer: document.referrer, url: location.href, accurateTrackBounce:true, trackLinks:true});`;
---
<!DOCTYPE html>
<html lang={lang}>
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content={robots}>
<meta name="color-scheme" content="light only">
<!-- Yandex.Metrika counter -->
<script is:inline type="text/javascript" set:html={METRIKA}></script>
<noscript><div><img src="https://mc.yandex.ru/watch/109819083" style="position:absolute; left:-9999px;" alt="" /></div></noscript>
<!-- /Yandex.Metrika counter -->
<title>{title}</title>
<meta name="description" content={description}>
{keywords && <meta name="keywords" content={keywords} />}
<meta name="author" content="Валентина Агеева">
<link rel="canonical" href={canonical}>
{i18n && (<Fragment>
<link rel="alternate" hreflang="ru" href={SITE + altRu} />
<link rel="alternate" hreflang="en" href={SITE + altEn} />
<link rel="alternate" hreflang="es" href={SITE + altEs} />
<link rel="alternate" hreflang="x-default" href={SITE + altRu} />
</Fragment>)}
<link rel="icon" type="image/svg+xml" href="/assets/favicon.svg">
<meta property="og:type" content={ogType}>
<meta property="og:site_name" content="Валентина Агеева — психология отношений">
<meta property="og:locale" content={T.locale}>
<meta property="og:url" content={ogUrl}>
<meta property="og:title" content={ogT}>
<meta property="og:description" content={ogD}>
<meta property="og:image" content="https://ageeva.win/assets/og-cover.webp">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={twT}>
<meta name="twitter:description" content={twD}>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;600;700&family=Nunito+Sans:wght@400;600;700;800&display=swap" media="print" onload="this.media='all'">
<noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;600;700&family=Nunito+Sans:wght@400;600;700;800&display=swap"></noscript>
<link rel="stylesheet" href="/assets/style.css">
<link rel="stylesheet" href="/assets/hooks.css">
<link rel="stylesheet" href="/assets/glass.css?v=1">
<slot name="head" />
<script src="https://analytics.asibots.pro/api/script.js" data-site-id="8" defer></script>
</head>
<body>

<header class="site-header">
  <div class="container nav">
    <a href={home} class="brand">{T.b1} <span>{T.b2}</span></a>
    <nav class="nav-links" id="navLinks">
      <a href={L('about.html')}>{T.about}</a>
      <a href={L('course.html')}>{T.course}</a>
      <a href="/tests/">{T.tests}</a>
      <a href={L('free.html')}>{T.free}</a>
      <a href={L('free.html')} class="btn btn-primary btn-sm nav-cta">{T.freeBtn}</a>
      {i18n && (
      <span class="lang-switch" style="display:inline-flex;gap:9px;align-items:center;font-size:13px;font-weight:700;margin-left:4px">
        <a href={altRu} style={lang === 'ru' ? 'color:var(--rose-deep)' : 'color:var(--muted);opacity:.65'}>RU</a>
        <a href={altEn} style={lang === 'en' ? 'color:var(--rose-deep)' : 'color:var(--muted);opacity:.65'}>EN</a>
        <a href={altEs} style={lang === 'es' ? 'color:var(--rose-deep)' : 'color:var(--muted);opacity:.65'}>ES</a>
      </span>
      )}
    </nav>
    <button class="nav-toggle" aria-label="Menu" onclick="document.getElementById('navLinks').classList.toggle('open')">☰</button>
  </div>
</header>

<slot />

<footer class="site-footer">
  <div class="container">
    <div class="foot">
      <div>
        <a href={home} class="brand">{T.b1} <span>{T.b2}</span></a>
        <p>{T.tag}</p>
        <div class="foot-social">
          <a href="https://t.me/valli790" target="_blank" rel="noopener" data-goal="tg_click">Telegram</a>
          <a href="https://instagram.com/ageeva_win" target="_blank" rel="noopener" data-goal="ig_click">Instagram</a>
        </div>
      </div>
      <div>
        <h4>{T.sec}</h4>
        <a href={L('about.html')}>{T.cAbout}</a>
        <a href={L('course.html')}>{T.cCourse}</a>
        <a href="/tests/">{T.cTests}</a>
        <a href={L('blog.html')}>{T.cBlog}</a>
      </div>
      <div>
        <h4>{T.con}</h4>
        <a href="https://t.me/valli790" target="_blank" rel="noopener" data-goal="tg_click">{T.cTg}</a>
        <a href="https://t.me/ageevawin_bot" target="_blank" rel="noopener" data-goal="bot_click">{T.cBot}</a>
        <a href="https://instagram.com/ageeva_win" target="_blank" rel="noopener" data-goal="ig_click">Instagram @ageeva_win</a>
        <a href={L('free.html')}>{T.cPdf}</a>
      </div>
    </div>
    <div class="foot-bottom">
      <span>© Валентина Агеева, 2026 · <a href="https://ageeva.win/">ageeva.win</a></span>
      <span><a href="#">{T.offer}</a> · <a href={L('privacy.html')}>{T.privacy}</a></span>
    </div>
  </div>
</footer>

{cms && <script src="/assets/cms.js" defer is:inline></script>}
<script src="/assets/app.js" defer is:inline></script>
<script src="https://mascot.asibots.pro/loader.js" data-skin="valya" data-onclick-url="https://t.me/ageevawin_bot" data-autorefresh="300" defer is:inline></script>
<script src="https://webcheck.ageeva.win/bugfix/loader.js" data-project="valya" defer is:inline></script>
<slot name="scripts" />

<script is:inline>
  window.chatwootSettings = { locale: "ru", position: "right", launcherTitle: "Спросить Валю" };
  (function(d,t){var BASE="https://chatwoot.asibots.pro";
    var g=d.createElement(t),s=d.getElementsByTagName(t)[0];
    g.src=BASE+"/packs/js/sdk.js";g.defer=!0;g.async=!0;s.parentNode.insertBefore(g,s);
    g.onload=function(){window.chatwootSDK.run({websiteToken:"9gdCjmdnAyMcEp62AstCAM98",baseUrl:BASE});};
  })(document,"script");
</script>
</body>
</html>
