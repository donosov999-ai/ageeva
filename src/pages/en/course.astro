---
import Layout from '../../layouts/Layout.astro';

const jsonldCourse = `{"@context":"https://schema.org","@type":"Course","name":"Relationships for a Lifetime","description":"A 10-step course: get out of the loop of fights and hear each other again. Without leaving and without «just put up with it».","inLanguage":"en","url":"https://ageeva.win/en/course.html","image":"https://ageeva.win/assets/og-cover.jpg","provider":{"@type":"Person","name":"Valentina Ageeva","url":"https://ageeva.win/"}}`;

const jsonldFaq = `{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[
{"@type":"Question","name":"How long does the course last?","acceptedAnswer":{"@type":"Answer","text":"One month — whatever tier you choose."}},
{"@type":"Question","name":"How do I enroll and pay for the course?","acceptedAnswer":{"@type":"Answer","text":"Tap «Enroll» on the tier you want — Telegram opens. Valentina will confirm your spot and send the payment link."}},
{"@type":"Question","name":"What happens right after payment?","acceptedAnswer":{"@type":"Answer","text":"You'll get a confirmation message in Telegram, and Valentina will open your access to the course."}},
{"@type":"Question","name":"How long does access last?","acceptedAnswer":{"@type":"Answer","text":"Access to the course stays open for 3 months from the start."}},
{"@type":"Question","name":"Can I get a refund?","acceptedAnswer":{"@type":"Answer","text":"Yes — the refund terms and deadlines are set out in the offer agreement."}},
{"@type":"Question","name":"What if it's not for me?","acceptedAnswer":{"@type":"Answer","text":"Start with the free test and the blog — you'll quickly feel whether Valentina's approach resonates with you or not. The course is the next step, not the first one."}}
]}`;
---
<Layout
  lang="en"
  altPath="course.html"
  i18n={true}
  title="Course «Relationships for a Lifetime» — from «we fought again» to «we're a team» | Valentina Ageeva"
  description="The course «Relationships for a Lifetime»: 10 steps to get out of the loop of fights and hear each other again. Second group starts in late June."
  keywords="relationship course, relationships for a lifetime, how to save a relationship, relationship psychology for women, get out of fights, repair a relationship with a man, relationship crisis, attachment theory, Gottman, Sue Johnson, Valentina Ageeva"
  canonical="https://ageeva.win/en/course.html"
  ogTitle="Course «Relationships for a Lifetime» — 10 steps to a strong relationship"
  ogDescription="10 steps: get out of the loop of fights and hear each other again. Without leaving and without «just put up with it». Second group starts in late June."
  twTitle="Course «Relationships for a Lifetime» — Valentina Ageeva"
  twDescription="10 steps from «we fought again» to «we're a team». Second group starts in late June."
>
  <script type="application/ld+json" is:inline set:html={jsonldCourse} slot="head"></script>
  <script type="application/ld+json" is:inline set:html={jsonldFaq} slot="head"></script>

<!-- 1. ПЕРВЫЙ ЭКРАН -->
<section class="hero">
  <div class="container">
    <div>
      <span class="eyebrow">Second group — starts in late June</span>
      <h1>Relationships for a lifetime</h1>
      <p class="lead" style="font-family:var(--serif);font-style:italic;color:var(--rose-ink);font-size:1.35rem;margin-bottom:16px">Lessons from four generations of women who knew how to hold their own</p>
      <p class="lead">In 10 steps — from «we fight all the time» to «we finally hear each other». Without leaving, without «just put up with it», and without fairy tales about a prince on a white horse.</p>
      <div class="btn-row">
        <a href="#tarify" class="btn btn-primary btn-lg">Enroll →</a>
        <a href="#program" class="btn btn-ghost btn-lg">See the program</a>
      </div>
    </div>
    <div class="photo photo--portrait">
      <img src="/assets/photo-hero.jpg" alt="Valentina Ageeva" id="photoHero">
    </div>
  </div>
</section>

<section class="section--tight"><div class="container"><div class="trust"><span>Course access — 3 months</span><span>Starts — late June</span><span>Enroll and pay — in Telegram</span><span>Refunds per the agreement</span></div></div></section>

<!-- 2. ДЛЯ КОГО / НЕ ДЛЯ КОГО -->
<section class="section bg-cream2">
  <div class="container">
    <div class="center">
      <span class="eyebrow">Honest upfront</span>
      <h2>Is this course for you?</h2>
      <hr class="rule center">
    </div>
    <div class="cols2" style="margin-top:34px">
      <div class="panel yes">
        <h3>This is for you if</h3>
        <ul>
          <li>you love him, but you're tired of the same old fights;</li>
          <li>you want to be heard, not brushed off;</li>
          <li>you're ready to look at yourself, not only at him;</li>
          <li>you want to keep your family, not learn how to walk away from it gracefully;</li>
          <li>your relationships end in roughly the same place — and you'd finally like to understand the pattern;</li>
          <li>you can't seem to hold a relationship longer than a few months — and you don't understand why.</li>
        </ul>
      </div>
      <div class="panel no">
        <h3>Who it's NOT for</h3>
        <ul>
          <li>If you're looking for proof that you should leave — I won't give it.</li>
          <li>If you want to learn how to change a man — also not for me.</li>
          <li>If there's violence in the relationship — see a specialist first.</li>
          <li>If you're expecting soft hugs and «it'll all be fine» — I'll be honest, often uncomfortably so.</li>
          <li>If you just want to listen, nod, and do nothing while getting handed a magic pill of happiness — this isn't it. Here you work, you don't watch. This is the real world, not a made-up plot from some soap opera.</li>
        </ul>
      </div>
    </div>
  </div>
</section>

<!-- 3. ЧТО ИЗМЕНИТСЯ -->
<section class="section">
  <div class="container">
    <div class="center">
      <span class="eyebrow">The result</span>
      <h2>What will change</h2>
      <hr class="rule center">
    </div>
    <table class="ba narrow" style="margin-top:24px">
      <tr><td>The same fight on a loop</td><td class="arrow">→</td><td>You see where you both take the wrong turn, and you know how to stop</td></tr>
      <tr><td>You speak — he shuts down</td><td class="arrow">→</td><td>You speak in a way he hears, instead of getting defensive</td></tr>
      <tr><td>«Either I endure it, or I leave»</td><td class="arrow">→</td><td>A third option appears — repair it</td></tr>
      <tr><td>Tenderness and sex on whatever's left over</td><td class="arrow">→</td><td>You understand where desire goes and how to bring it back</td></tr>
      <tr><td>You keep choosing «the wrong ones»</td><td class="arrow">→</td><td>You see your script — and stop repeating it</td></tr>
      <tr><td>The same scenario over and over</td><td class="arrow">→</td><td>You spot your pattern before it kicks in — and change the move</td></tr>
      <tr><td>Relationships fizzle out at month 1–3</td><td class="arrow">→</td><td>You understand what's scaring him off — and you get past that point</td></tr>
    </table>
  </div>
</section>

<!-- 4. ПРОГРАММА -->
<section class="section bg-blush" id="program">
  <div class="container">
    <div class="center">
      <span class="eyebrow">The program</span>
      <h2>10 steps</h2>
      <hr class="rule center">
    </div>
    <div class="steps" style="margin-top:34px">
      <div class="step"><h3>Where you actually are right now</h3><p>We learn to tell reality from the pretty pictures — including your own.</p><span class="hw">homework included</span></div>
      <div class="step"><h3>Why you react the way you do</h3><p>How fear runs your decisions — and who takes advantage of that.</p><span class="hw">homework included</span></div>
      <div class="step"><h3>The roles you get pushed into</h3><p>Two traps almost every woman falls into — and how to get out of them.</p><span class="hw">homework included</span></div>
      <div class="step"><h3>What kinds of men there are, and why you choose «the wrong ones»</h3><p>Three types of men — and your pattern of choosing.</p><span class="hw">homework included</span></div>
      <div class="step"><h3>The game of staying power</h3><p>Why stability sometimes looks like boredom — and how not to confuse the two.</p><span class="hw">homework included</span></div>
      <div class="step"><h3>What you look at is what grows</h3><p>Your focus decides more than it seems. We learn to look where it matters.</p><span class="hw">homework included</span></div>
      <div class="step"><h3>Strength in softness</h3><p>Why vulnerability is a tool, not a weakness.</p><span class="hw">homework included</span></div>
      <div class="step"><h3>How to stay in his memory</h3><p>Simple things that make you irreplaceable.</p><span class="hw">homework included</span></div>
      <div class="step"><h3>What each side brings</h3><p>Who brings what into the relationship — and why balance matters more than it seems.</p><span class="hw">homework included</span></div>
      <div class="step"><h3>What's next</h3><p>We lock in the result and a concrete plan of action.</p></div>
    </div>
  </div>
</section>

<!-- 5. КАК УСТРОЕНО -->
<section class="section">
  <div class="container narrow center">
    <span class="eyebrow">The format</span>
    <h2>How it works</h2>
    <hr class="rule center">
    <p class="lead">10 steps on-demand + 9 homework tasks + your personal wrap-up. You watch at your own pace, with course access for 3 months. The homework is short — 15–20 minutes, not «write me a three-page essay». Your final map is built from what you've completed, taking your homework into account, with clear next steps to act on.</p>
  </div>
</section>

<!-- 6. ТАРИФЫ -->
<section class="section bg-cream2" id="tarify">
  <div class="container">
    <div class="center">
      <span class="eyebrow">Tiers</span>
      <h2>Pick what works for you</h2>
      <hr class="rule center">
      <p class="lead narrow">The course runs for 1 month, whichever format you choose.</p>
    </div>
    <div class="prices" style="margin-top:42px">
      <div class="price">
        <h3>On your own</h3>
        <div class="tag">for those used to doing it themselves</div>
        <ul>
          <li>10 steps on-demand</li>
          <li>auto-checked homework</li>
          <li>shared group chat</li>
          <li>psych profile and strategy</li>
        </ul>
        <div class="amount">€39</div>
        <a href="https://t.me/valli790" target="_blank" rel="noopener" class="btn btn-ghost" data-goal="tariff_sama">Enroll «On your own» →</a>
      </div>
      <div class="price price--featured">
        <span class="price__badge">⭐ Most popular choice</span>
        <h3>With Valentina</h3>
        <div class="tag">9 spots left</div>
        <ul>
          <li>10 steps on-demand</li>
          <li>homework checked personally by Valentina</li>
          <li>answers and feedback in private chat</li>
          <li>shared group chat</li>
          <li>psych profile and strategy</li>
        </ul>
        <div class="amount">€69</div>
        <a href="https://t.me/valli790" target="_blank" rel="noopener" class="btn btn-primary" data-goal="tariff_valya">Enroll «With Valentina» →</a>
      </div>
      <div class="price">
        <h3>VIP 1-on-1</h3>
        <div class="tag">personal work</div>
        <ul>
          <li>everything in «With Valentina»</li>
          <li>personal guidance</li>
          <li>psych profile</li>
          <li>individual strategy</li>
        </ul>
        <div class="amount">€2,500</div>
        <a href="https://t.me/valli790" target="_blank" rel="noopener" class="btn btn-ghost" data-goal="tariff_vip">Discuss VIP in Telegram →</a>
      </div>
    </div>
    <p class="lead narrow center" style="margin-top:30px">Most people take «On your own» — it's enough to get out of the loop by yourself. «With Valentina» is for when you want to be led by the hand and get personal answers.</p>
    <p class="tg-ask">Still have questions about the course? <a href="https://t.me/valli790" target="_blank" rel="noopener" data-goal="tg_click">Ask Valentina on Telegram →</a></p>
  </div>
</section>

<!-- 7. КТО ВЕДЁТ -->
<section class="section">
  <div class="container grid grid-2" style="align-items:center">
    <div class="photo photo--round">
      <img src="/assets/photo-round2.jpg" alt="Valentina Ageeva" id="photoRound" loading="lazy">
    </div>
    <div>
      <span class="eyebrow">Who's teaching</span>
      <h2>It's me, Valentina</h2>
      <hr class="rule">
      <p>Not out of a textbook — out of what I lived through myself and pieced together from the work of Gottman and Sue Johnson. No esoterics and no «just love yourself».</p>
      <a href="/en/about.html" class="btn btn-ghost">More about me →</a>
    </div>
  </div>
</section>

<!-- 8. FAQ -->
<section class="section bg-blush">
  <div class="container">
    <div class="center">
      <span class="eyebrow">Questions about payment</span>
      <h2>The important bits, briefly</h2>
      <hr class="rule center">
    </div>
    <div class="faq" style="margin-top:30px">
      <details open><summary>How long does the course last?</summary><p>One month — whatever tier you choose.</p></details>
      <details><summary>How do I enroll and pay?</summary><p>Tap «Enroll» on the tier you want — Telegram opens. I'll confirm your spot and send the payment link.</p></details>
      <details><summary>What happens right after payment?</summary><p>You'll get a confirmation message in Telegram — and I'll open your access to the course.</p></details>
      <details><summary>How long does access last?</summary><p>Access to the course stays open for 3 months from the start.</p></details>
      <details><summary>Can I get a refund?</summary><p>Yes — the refund terms and deadlines are set out in the offer agreement.</p></details>
      <details><summary>What if it's not for me?</summary><p>Start with the free test and the blog — you'll quickly feel whether my approach resonates with you or not. The course is the next step, not the first one.</p></details>
    </div>
  </div>
</section>

<!-- 9. ФИНАЛЬНЫЙ CTA -->
<section class="section">
  <div class="container">
    <div class="cta-band">
      <span class="eyebrow">Second group — starts in late June</span>
      <h2>You can spend another year going in circles. Or take 10 steps and get out</h2>
      <p>The first is free and familiar. The second is the course «Relationships for a Lifetime». Pick a tier, and let's begin.</p>
      <div class="btn-row center">
        <a href="#tarify" class="btn btn-primary btn-lg">Pick a tier and enroll →</a>
        <a href="/en/free.html" class="btn btn-ghost btn-lg">Start with the free test</a>
      </div>
    </div>
  </div>
</section>
</Layout>
