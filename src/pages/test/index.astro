      <a href="/free.html" class="btn btn-primary btn-sm nav-cta">Бесплатный тест</a>
    </nav>
  </div>
</header>
<div id="testRoot"><div class="container" style="padding:90px 24px;text-align:center;color:var(--muted)">Загружаю тест…</div></div>
<script src="/assets/test-render.js" is:inline></script>
</body>
</html>
