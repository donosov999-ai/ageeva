<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light only">
<script is:inline type="text/javascript" set:html={METRIKA}></script>
<noscript><div><img src="https://mc.yandex.ru/watch/109819083" style="position:absolute; left:-9999px;" alt="" /></div></noscript>
<title>Тест · Отношения длиною в жизнь</title>
<link rel="icon" type="image/svg+xml" href="/assets/favicon.svg">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;600;700&family=Nunito+Sans:wght@400;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/assets/style.css">
<style>
  .qcard{background:#fff;border:1px solid var(--line,#ecdcd7);border-radius:16px;padding:20px 22px;margin:14px 0;transition:.15s}
  .qcard.miss{border-color:var(--rose-deep,#be7e75);box-shadow:0 0 0 3px rgba(190,126,117,.16)}
  .qtext{font-weight:700;margin:0 0 13px;font-size:17px;line-height:1.42}
  .qopts{display:flex;flex-wrap:wrap;gap:8px}
  .qopt{border:1.5px solid var(--line,#ecdcd7);background:#fff;border-radius:999px;padding:9px 16px;font:inherit;font-size:14px;font-weight:600;cursor:pointer;color:var(--ink,#3a2e2b);transition:.15s;-webkit-tap-highlight-color:transparent}
  .qopt:hover{border-color:var(--rose-deep,#be7e75)}
  .qopt.on{background:var(--rose-deep,#be7e75);border-color:var(--rose-deep,#be7e75);color:#fff}
  .qsubmit{text-align:center;margin:30px 0 6px}
  .qhint{color:var(--rose-deep,#be7e75);font-weight:600;font-size:14px;margin-top:12px;min-height:1em}
  .qresult{background:var(--blush,#fbf3f1);border:1px solid var(--line,#ecdcd7);border-radius:22px;padding:34px 30px;margin-top:20px;text-align:center}
  .qbar{height:10px;border-radius:999px;background:#ecdcd7;overflow:hidden;max-width:320px;margin:16px auto 6px}
  .qbar span{display:block;height:100%;background:var(--rose-deep,#be7e75);border-radius:999px;transition:width .5s}
  .qscore{font-weight:700;color:var(--rose-ink,#9c5d54);margin:0 0 18px}
  .qresult>p{text-align:left;max-width:560px;margin:0 auto 14px;line-height:1.62}
  .qcta{margin-top:24px;border-top:1px solid var(--line,#ecdcd7);padding-top:22px}
  .qcta p{text-align:center}
  .qretry{margin-top:18px;background:none;border:none;color:var(--muted,#9b8e8a);text-decoration:underline;cursor:pointer;font:inherit;font-size:14px}
</style>
</head>
<body>
<header class="site-header">
  <div class="container nav">
    <a href="/" class="brand">Отношения <span>длиною в жизнь</span></a>
