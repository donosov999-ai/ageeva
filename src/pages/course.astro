---
import Layout from '../layouts/Layout.astro';

const jsonldCourse = `{"@context":"https://schema.org","@type":"Course","name":"Отношения длиною в жизнь","description":"Курс из 10 шагов: выйти из круга ссор и снова услышать друг друга. Без ухода и без «терпи».","inLanguage":"ru-RU","url":"https://ageeva.win/course.html","image":"https://ageeva.win/assets/og-cover.jpg","provider":{"@type":"Person","name":"Валентина Агеева","url":"https://ageeva.win/"}}`;

const jsonldFaq = `{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[
{"@type":"Question","name":"Сколько длится курс?","acceptedAnswer":{"@type":"Answer","text":"1 месяц — независимо от выбранного тарифа."}},
{"@type":"Question","name":"Как записаться и оплатить курс?","acceptedAnswer":{"@type":"Answer","text":"Нажми «Записаться» в нужном тарифе — откроется Telegram. Валентина подтвердит место и пришлёт ссылку на оплату."}},
{"@type":"Question","name":"Что будет сразу после оплаты?","acceptedAnswer":{"@type":"Answer","text":"Придёт сообщение с подтверждением в Telegram, и Валентина откроет доступ к курсу."}},
{"@type":"Question","name":"Сколько остаётся доступ?","acceptedAnswer":{"@type":"Answer","text":"Доступ к курсу остаётся на 3 месяца с момента старта."}},
{"@type":"Question","name":"Можно вернуть деньги?","acceptedAnswer":{"@type":"Answer","text":"Да, условия и сроки возврата прописаны в оферте."}},
{"@type":"Question","name":"А если мне не подойдёт?","acceptedAnswer":{"@type":"Answer","text":"Начни с бесплатного теста и блога — сразу станет понятно, откликается тебе подход Валентины или нет. Курс — следующий шаг, не первый."}}
]}`;
---
<Layout
  i18n={true}
  altPath="course.html"
  title="Курс «Отношения длиною в жизнь» — от «опять поссорились» до «мы команда» | Валентина Агеева"
  description="Курс «Отношения длиною в жизнь»: 10 шагов, чтобы выйти из круга ссор и снова услышать друг друга. Старт второго потока — 26 июля."
  keywords="курс по отношениям, отношения длиною в жизнь, как сохранить отношения, психология отношений для женщин, выйти из ссор, наладить отношения с мужчиной, кризис в отношениях, теория привязанности, Готтман, Сью Джонсон, Валентина Агеева"
  canonical="https://ageeva.win/course.html"
  ogTitle="Курс «Отношения длиною в жизнь» — 10 шагов к крепким отношениям"
  ogDescription="10 шагов: выйти из круга ссор и снова услышать друг друга. Без ухода и без «терпи». Старт второго потока — 26 июля."
  twTitle="Курс «Отношения длиною в жизнь» — Валентина Агеева"
  twDescription="10 шагов от «опять поссорились» до «мы команда». Старт второго потока — 26 июля."
>
  <script type="application/ld+json" is:inline set:html={jsonldCourse} slot="head"></script>
  <script type="application/ld+json" is:inline set:html={jsonldFaq} slot="head"></script>

<!-- 1. ПЕРВЫЙ ЭКРАН -->
<section class="hero">
  <div class="container">
    <div>
      <span class="eyebrow">Второй поток — старт 26 июля</span>
      <h1>Отношения длиною в жизнь</h1>
      <p class="lead" style="font-family:var(--serif);font-style:italic;color:var(--rose-ink);font-size:1.35rem;margin-bottom:16px">Уроки от стерв четырёх поколений</p>
      <p class="lead">За 10 шагов — от «мы всё время ссоримся» к «мы наконец слышим друг друга». Без ухода, без «терпи» и без сказок про принца на белом коне.</p>
      <div class="btn-row">
        <a href="#tarify" class="btn btn-primary btn-lg">Записаться →</a>
        <a href="#program" class="btn btn-ghost btn-lg">Смотреть программу</a>
      </div>
    </div>
    <div class="photo photo--portrait">
      <img src="/assets/photo-hero.jpg" alt="Валентина Агеева" id="photoHero">
    </div>
  </div>
</section>

<section class="section--tight"><div class="container"><div class="trust"><span>Доступ к курсу — 3 месяца</span><span>Старт — 26 июля</span><span>Запись и оплата — в Telegram</span><span>Возврат по оферте</span></div></div></section>

<!-- 2. ДЛЯ КОГО / НЕ ДЛЯ КОГО -->
<section class="section bg-cream2">
  <div class="container">
    <div class="center">
      <span class="eyebrow">Честно на берегу</span>
      <h2>Этот курс для тебя?</h2>
      <hr class="rule center">
    </div>
    <div class="cols2" style="margin-top:34px">
      <div class="panel yes">
        <h3>Тебе сюда, если</h3>
        <ul>
          <li>любишь его, но устала от одних и тех же ссор;</li>
          <li>хочешь, чтобы тебя слышали, а не отмахивались;</li>
          <li>готова разбираться в себе, а не только в нём;</li>
          <li>хочешь сохранить семью, а не научиться красиво из неё уходить;</li>
          <li>отношения заканчиваются примерно в одном и том же месте — хочется наконец понять закономерность;</li>
          <li>у тебя не получается удержать отношения дольше нескольких месяцев — и ты не понимаешь почему.</li>
        </ul>
      </div>
      <div class="panel no">
        <h3>Кому НЕ подойдёт</h3>
        <ul>
          <li>Если ищешь подтверждение, что надо уйти — я не дам.</li>
          <li>Если хочешь узнать, как изменить мужчину — тоже не ко мне.</li>
          <li>Если в отношениях есть насилие — сначала к специалисту.</li>
          <li>Если ждёшь мягких объятий и «всё будет хорошо» — я буду честной, часто неудобно.</li>
          <li>Если хочешь просто послушать, покивать и ничего не делать, получив волшебную пилюльку счастья — это не сюда. Здесь работают, а не наблюдают. Здесь реальный мир, а не вымышленный сценарий из турецкого сериальчика.</li>
        </ul>
      </div>
    </div>
  </div>
</section>

<!-- 3. ЧТО ИЗМЕНИТСЯ -->
<section class="section">
  <div class="container">
    <div class="center">
      <span class="eyebrow">Результат</span>
      <h2>Что изменится</h2>
      <hr class="rule center">
    </div>
    <table class="ba narrow" style="margin-top:24px">
      <tr><td>Один и тот же скандал по кругу</td><td class="arrow">→</td><td>Видишь, где вы сворачиваете не туда, и умеешь остановиться</td></tr>
      <tr><td>Говоришь — он закрывается</td><td class="arrow">→</td><td>Говоришь так, что он слышит, а не защищается</td></tr>
      <tr><td>«Или терплю, или ухожу»</td><td class="arrow">→</td><td>Появляется третий вариант — починить</td></tr>
      <tr><td>Нежность и секс по остаточному принципу</td><td class="arrow">→</td><td>Понимаешь, куда уходит желание и как его вернуть</td></tr>
      <tr><td>По кругу выбираешь «не тех»</td><td class="arrow">→</td><td>Видишь свой сценарий — и не повторяешь его</td></tr>
      <tr><td>Один и тот же сценарий</td><td class="arrow">→</td><td>Видишь свой паттерн до того, как он сработает — и меняешь ход</td></tr>
      <tr><td>Отношения тухнут на 1–3 месяце</td><td class="arrow">→</td><td>Понимаешь, что отпугивает — и проходишь дальше этой точки</td></tr>
    </table>
  </div>
</section>

<!-- 4. ПРОГРАММА -->
<section class="section bg-blush" id="program">
  <div class="container">
    <div class="center">
      <span class="eyebrow">Программа</span>
      <h2>10 ступеней</h2>
      <hr class="rule center">
    </div>
    <div class="steps" style="margin-top:34px">
      <div class="step"><h3>Где ты сейчас на самом деле</h3><p>Учимся отличать реальность от красивых картинок — в том числе своей собственной.</p><span class="hw">есть домашка</span></div>
      <div class="step"><h3>Почему ты так реагируешь</h3><p>Как страх управляет твоими решениями — и кто этим пользуется.</p><span class="hw">есть домашка</span></div>
      <div class="step"><h3>Роли, в которые тебя толкают</h3><p>Две ловушки, в которые попадает почти каждая — и как из них выйти.</p><span class="hw">есть домашка</span></div>
      <div class="step"><h3>Какие мужчины бывают и почему ты выбираешь «не тех»</h3><p>Три типа мужчин — и твой паттерн выбора.</p><span class="hw">есть домашка</span></div>
      <div class="step"><h3>Игра в постоянство</h3><p>Почему стабильность иногда выглядит как скука — и как не путать одно с другим.</p><span class="hw">есть домашка</span></div>
      <div class="step"><h3>На что ты смотришь — то и растёт</h3><p>Твой фокус решает больше, чем кажется. Учимся смотреть туда, куда нужно.</p><span class="hw">есть домашка</span></div>
      <div class="step"><h3>Сила в слабости</h3><p>Почему уязвимость — это инструмент, а не слабость.</p><span class="hw">есть домашка</span></div>
      <div class="step"><h3>Как остаться в его памяти</h3><p>Простые вещи, которые делают тебя незаменимой.</p><span class="hw">есть домашка</span></div>
      <div class="step"><h3>Вклад с двух сторон</h3><p>Кто и что приносит в отношения — и почему баланс важнее, чем кажется.</p><span class="hw">есть домашка</span></div>
      <div class="step"><h3>Что дальше</h3><p>Закрепляем результат и конкретный план действий.</p></div>
    </div>
  </div>
</section>

<!-- 5. КАК УСТРОЕНО -->
<section class="section">
  <div class="container narrow center">
    <span class="eyebrow">Формат</span>
    <h2>Как это устроено</h2>
    <hr class="rule center">
    <p class="lead">10 ступеней в записи + 9 домашек + личный итог. Смотришь в удобном темпе, доступ к курсу — 3 месяца. Домашки короткие — 15–20 минут, а не «напиши сочинение на три страницы». Итоговая карта — по результатам пройденного курса, с учётом сделанных домашних заданий, с дальнейшими рекомендациями к действиям.</p>
  </div>
</section>

<!-- 6. ТАРИФЫ -->
<section class="section bg-cream2" id="tarify">
  <div class="container">
    <div class="center">
      <span class="eyebrow">Тарифы</span>
      <h2>Выбери, как тебе удобнее</h2>
      <hr class="rule center">
      <p class="lead narrow">Длительность курса — 1 месяц, независимо от выбранного формата.</p>
    </div>
    <div class="prices" style="margin-top:42px">
      <div class="price">
        <h3>Сама</h3>
        <div class="tag">для тех, кто привык сам</div>
        <ul>
          <li>10 ступеней в записи</li>
          <li>автопроверка домашек</li>
          <li>общий чат участниц</li>
          <li>психопортрет и стратегия</li>
        </ul>
        <div class="amount">3 900 ₽</div>
        <a href="https://t.me/valli790" target="_blank" rel="noopener" class="btn btn-ghost" data-goal="tariff_sama" data-apply data-tier="Сама — 3 900 ₽">Записаться «Сама» →</a>
      </div>
      <div class="price price--featured">
        <span class="price__badge">⭐ Выбор большинства</span>
        <h3>С Валентиной</h3>
        <div class="tag">осталось 9 мест</div>
        <ul>
          <li>10 ступеней в записи</li>
          <li>домашки проверяет лично Валентина</li>
          <li>ответы и разбор в личке</li>
          <li>общий чат участниц</li>
          <li>психопортрет и стратегия</li>
        </ul>
        <div class="amount">6 900 ₽</div>
        <a href="https://t.me/valli790" target="_blank" rel="noopener" class="btn btn-primary" data-goal="tariff_valya" data-apply data-tier="С Валентиной — 6 900 ₽">Записаться «С Валентиной» →</a>
      </div>
      <div class="price">
        <h3>VIP 1-на-1</h3>
        <div class="tag">личная работа</div>
        <ul>
          <li>всё из тарифа «С Валентиной»</li>
          <li>личное сопровождение</li>
          <li>психопортрет</li>
          <li>индивидуальная стратегия</li>
        </ul>
        <div class="amount">250 000 ₽</div>
        <a href="https://t.me/valli790" target="_blank" rel="noopener" class="btn btn-ghost" data-goal="tariff_vip" data-apply data-tier="VIP 1-на-1 — 250 000 ₽">Обсудить VIP в Telegram →</a>
      </div>
    </div>
    <p class="lead narrow center" style="margin-top:30px">Большинство берёт «Сама» — этого хватает, чтобы выйти из круга самостоятельно. «С Валентиной» — если хочешь, чтобы тебя вели за руку и отвечали лично.</p>
    <p class="tg-ask">Остались вопросы по курсу? <a href="https://t.me/valli790" target="_blank" rel="noopener" data-goal="tg_click">Спросить Валентину в Telegram →</a></p>
  </div>
</section>

<!-- 7. КТО ВЕДЁТ -->
<section class="section">
  <div class="container grid grid-2" style="align-items:center">
    <div class="photo photo--round">
      <img src="/assets/photo-round2.jpg" alt="Валентина Агеева" id="photoRound" loading="lazy">
    </div>
    <div>
      <span class="eyebrow">Кто ведёт</span>
      <h2>Веду я, Валентина</h2>
      <hr class="rule">
      <p>Не по учебнику — по тому, что прошла сама и собрала из работ Готтмана и Джонсон. Без эзотерики и без «просто полюби себя».</p>
      <a href="about.html" class="btn btn-ghost">Подробнее обо мне →</a>
    </div>
  </div>
</section>

<!-- 8. FAQ -->
<section class="section bg-blush">
  <div class="container">
    <div class="center">
      <span class="eyebrow">Вопросы об оплате</span>
      <h2>Коротко о важном</h2>
      <hr class="rule center">
    </div>
    <div class="faq" style="margin-top:30px">
      <details open><summary>Сколько длится курс?</summary><p>1 месяц — независимо от выбранного тарифа.</p></details>
      <details><summary>Как записаться и оплатить?</summary><p>Нажми «Записаться» в нужном тарифе — откроется Telegram. Я подтвержу место и пришлю ссылку на оплату.</p></details>
      <details><summary>Что будет сразу после оплаты?</summary><p>Придёт сообщение с подтверждением в Telegram — и я открою тебе доступ к курсу.</p></details>
      <details><summary>Сколько остаётся доступ?</summary><p>Доступ к курсу остаётся на 3 месяца с момента старта.</p></details>
      <details><summary>Можно вернуть деньги?</summary><p>Да — условия и сроки возврата прописаны в оферте.</p></details>
      <details><summary>А если мне не подойдёт?</summary><p>Начни с бесплатного теста и блога — сразу станет понятно, откликается тебе мой подход или нет. Курс — следующий шаг, не первый.</p></details>
    </div>
  </div>
</section>

<!-- 9. ФИНАЛЬНЫЙ CTA -->
<section class="section">
  <div class="container">
    <div class="cta-band">
      <span class="eyebrow">Второй поток — старт 26 июля</span>
      <h2>Можно ещё год по кругу. А можно — за 10 шагов из него выйти</h2>
      <p>Первое — бесплатно и привычно. Второе — курс «Отношения длиною в жизнь». Выбирай тариф, и начнём.</p>
      <div class="btn-row center">
        <a href="#tarify" class="btn btn-primary btn-lg">Выбрать тариф и записаться →</a>
        <a href="free.html" class="btn btn-ghost btn-lg">Сначала бесплатный тест</a>
      </div>
    </div>
  </div>
</section>
  <script src="/assets/course-apply.js" defer is:inline slot="scripts"></script>
</Layout>
