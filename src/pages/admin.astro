---
import Admin from '../components/Admin.jsx';
---
<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<meta name="color-scheme" content="light only">
<title>Админка · Отношения длиною в жизнь</title>
<link rel="icon" type="image/svg+xml" href="/assets/favicon.svg">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;600;700&family=Nunito+Sans:wght@400;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/assets/style.css">
<style is:global>
  body.ed-body{font-size:16px;line-height:1.5;background:var(--cream);min-height:100vh}
  /* вход */
  .ed-login{max-width:380px;margin:8vh auto 0;background:#fff;border:1px solid var(--line);border-radius:18px;padding:28px 26px;box-shadow:var(--shadow-sm)}
  .ed-login h1{font-size:23px!important;margin:0 0 4px}
  .ed-login p{color:var(--muted);margin:0 0 18px;font-size:14px}
  .ed-login label{display:block;font-weight:700;font-size:13px;color:var(--muted);margin:0 0 5px}
  .ed-login input{width:100%;font-size:15px;padding:11px 13px;border:1.5px solid var(--line);border-radius:10px;background:#fff;color:var(--ink);font-family:var(--sans)}
  .ed-login input:focus{outline:0;border-color:var(--rose)}
  .ed-err{color:#C0524B;font-weight:700;font-size:14px;min-height:18px;margin-top:8px}
  /* каркас */
  .ed-shell{display:flex;gap:24px;max-width:1180px;margin:0 auto;padding:20px 18px 90px;align-items:flex-start}
  .ed-side{position:sticky;top:20px;flex:0 0 200px;display:flex;flex-direction:column;gap:6px}
  .ed-brand{font-family:var(--serif);font-weight:700;font-size:18px;color:var(--ink);padding:6px 14px 10px}
  .ed-nav{text-align:left;background:transparent;border:0;border-radius:12px;padding:11px 16px;font-weight:700;font-size:15px;color:var(--rose-ink);cursor:pointer;font-family:var(--sans)}
  .ed-nav:hover{background:var(--cream-2)}
  .ed-nav.on{background:var(--rose-deep);color:#fff}
  .ed-out{margin-top:14px;color:var(--muted)}
  .ed-main{flex:1;min-width:0}
  .ed-h1{font-size:24px!important;margin:0 0 4px;font-family:var(--serif)}
  .ed-subhint{color:var(--muted);font-size:14px;margin:0 0 18px}
  /* форма | превью */
  .ed-split{display:grid;grid-template-columns:1fr 1fr;gap:20px;align-items:start}
  .ed-form{min-width:0}
  .ed-field{margin-bottom:12px}
  .ed-field label{display:block;font-weight:700;font-size:13px;color:var(--muted);margin:0 0 5px}
  .ed-field input,.ed-field textarea{width:100%;font-size:15px;padding:10px 12px;border:1.5px solid var(--line);border-radius:10px;background:#fff;color:var(--ink);font-family:var(--sans);line-height:1.5}
  .ed-field textarea{resize:vertical}
  .ed-field input:focus,.ed-field textarea:focus{outline:0;border-color:var(--rose)}
  .ed-hint{color:var(--muted);font-size:12px;margin-top:4px}
  .ed-row{display:flex;gap:12px;flex-wrap:wrap}
  .ed-row .ed-field{flex:1;min-width:120px}
  .ed-narrow{max-width:130px}
  /* карточки */
  .ed-card{background:#fff;border:1px solid var(--line);border-radius:16px;padding:16px;margin-bottom:14px;box-shadow:var(--shadow-sm)}
  .ed-card.off{opacity:.62;background:#FBF6F1}
  .ed-foot{display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-top:8px}
  .ed-chk{display:inline-flex;align-items:center;gap:8px;font-weight:700;font-size:14px;color:var(--ink);cursor:pointer}
  .ed-chk input{width:auto}
  .ed-spacer{flex:1}
  /* кнопки */
  .ed-btn{font-family:var(--sans);font-weight:800;border:0;border-radius:11px;padding:11px 18px;cursor:pointer;font-size:15px;transition:.15s}
  .ed-btn:active{transform:translateY(1px)}
  .ed-btn.ed-sm{padding:8px 13px;font-size:13.5px;border-radius:9px}
  .ed-p{background:var(--rose-deep);color:#fff}
  .ed-p:hover{background:var(--rose-ink)}
  .ed-g{background:transparent;color:var(--rose-ink);border:1.5px solid var(--rose);margin-bottom:14px}
  .ed-g:hover{background:var(--cream-2)}
  .ed-d{background:transparent;color:#C0524B;border:1.5px solid #E7C2BE}
  .ed-d:hover{background:#FBEFEE}
  /* превью */
  .ed-preview{position:sticky;top:20px;border:1px solid var(--line);border-radius:14px;background:var(--cream);overflow:hidden;max-height:82vh;overflow-y:auto}
  .ed-preview.sm{position:static;max-height:none}
  .ed-preview-tag{font-size:11px;font-weight:800;letter-spacing:.1em;text-transform:uppercase;color:var(--muted);padding:7px 12px;background:var(--cream-2);border-bottom:1px solid var(--line);position:sticky;top:0}
  .ed-preview-body{padding:4px 0 10px}
  /* приручить вёрстку сайта внутри превью */
  .ed-preview .section,.ed-preview .hero{padding:14px 0!important;min-height:0!important}
  .ed-preview .hero::before{display:none!important}
  .ed-preview .hero .container{display:block!important;grid-template-columns:1fr!important;padding:0 18px!important}
  .ed-preview .container{padding:0 18px!important;max-width:none!important}
  .ed-preview .cta-band{padding:24px 18px}
  .ed-preview h1{font-size:1.7rem!important}
  .ed-preview h2{font-size:1.3rem!important}
  .ed-preview .lead{font-size:1.04rem}
  .ed-preview .bignum{font-size:2.2rem}
  .ed-preview .story{max-width:none;margin:0;padding:0 18px}
  .ed-preview .story p{font-size:1rem}
  /* bcard для превью блога */
  .ed-preview .bcard{background:#fff;border:1.5px solid var(--line);border-radius:16px;overflow:hidden;margin:0 16px}
  .ed-preview .bcard-img img{display:block;width:100%;max-height:190px;object-fit:cover}
  .ed-preview .bcard-body{padding:16px 18px}
  .ed-preview .bcard h2{font-family:var(--serif);font-size:19px!important;margin:0 0 8px;line-height:1.18}
  .ed-preview .bcard-lead{font-size:15px;color:var(--rose-ink);margin:0 0 10px;font-weight:600}
  .ed-preview .bcard-text{font-size:14.5px;line-height:1.6}
  /* фото */
  .ed-photos{display:grid;gap:16px;grid-template-columns:repeat(auto-fit,minmax(200px,1fr))}
  .ed-photo{background:#fff;border:2px dashed var(--line);border-radius:16px;padding:16px;text-align:center;transition:.15s}
  .ed-photo.over{border-color:var(--rose-deep);background:var(--blush-2)}
  .ed-photo-t{font-weight:700;font-size:14px;margin-bottom:10px}
  .ed-photo-t span{display:block;font-weight:400;color:var(--muted);font-size:12px}
  .ed-photo img{width:100%;max-width:180px;aspect-ratio:4/5;object-fit:cover;border-radius:12px;border:1px solid var(--line);margin:0 auto 12px}
  .ed-photo img.rnd{aspect-ratio:1;border-radius:50%}
  .ed-photo-hint{color:var(--muted);font-size:12px;margin-top:8px}
  /* заявки */
  .ed-lead{display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap}
  .ed-contact{color:var(--rose-deep);font-weight:700}
  .ed-lead-meta{color:var(--muted);font-size:13px;margin-top:5px}
  /* тост */
  .ed-toast{position:fixed;left:50%;bottom:26px;transform:translateX(-50%);background:var(--ink);color:#fff;padding:13px 20px;border-radius:12px;font-weight:700;font-size:14.5px;z-index:60;box-shadow:var(--shadow)}
  .ed-toast.ok{background:#3F8F62}
  .ed-toast.bad{background:#C0524B}
  .ed-empty{color:var(--muted);text-align:center;padding:26px 0}
  @media(max-width:820px){
    .ed-shell{flex-direction:column}
    .ed-side{position:static;flex-direction:row;flex-wrap:wrap;width:100%;flex:none}
    .ed-split{grid-template-columns:1fr}
    .ed-preview{position:static;max-height:none}
  }
</style>
</head>
<body class="ed-body">
<Admin client:only="preact" />
</body>
</html>
