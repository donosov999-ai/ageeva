---
import Layout from '../layouts/Layout.astro';
---
<Layout
  i18n={true}
  altPath="free.html"
  title="Бесплатный тест на тип привязанности — Валентина Агеева"
  description="Узнай свой тип привязанности за 5 минут. Бесплатно + PDF-гайд в подарок."
  keywords="тест на тип привязанности, тип привязанности, тест отношения, теория привязанности, тревожный тип, избегающий тип, надёжная привязанность, бесплатный тест отношения, психология отношений, Валентина Агеева"
  canonical="https://ageeva.win/free.html"
  ogTitle="Бесплатный тест на тип привязанности — Валентина Агеева"
  ogDescription="Узнай свой тип привязанности за 5 минут. Бесплатно + PDF-гайд в подарок."
  twTitle="Бесплатный тест на тип привязанности"
  twDescription="Узнай свой тип привязанности за 5 минут. Бесплатно + PDF-гайд."
  cms={true}
>
  <style is:inline slot="head">
/* Тест привязанности — на бренде «Отношения длиною в жизнь» */
.atest{max-width:680px;margin:30px auto 0;background:#fff;border:1.5px solid var(--line);border-radius:18px;padding:26px 28px;box-shadow:0 10px 30px rgba(155,84,78,.06)}
.atest .scale-note{font-size:.92rem;color:var(--muted);margin:0 0 16px;text-align:center}
.slider-q{padding:15px 0;border-bottom:1px solid var(--line)}
.slider-q:last-of-type{border-bottom:0}
.slider-q .q{font-weight:700;margin-bottom:12px;color:var(--ink)}
.slider-row{display:flex;align-items:center;gap:9px}
.slider-min,.slider-max{font-size:.74rem;color:var(--muted);flex:0 1 60px;min-width:0;line-height:1.15}
.slider-max{text-align:right}
.slider-q input[type=range]{flex:1;accent-color:var(--rose-deep)}
.slider-val{flex:0 0 20px;text-align:center;font-weight:800;color:var(--rose-deep)}
.slider-val.unset{color:var(--rose)}
.atest-btns{display:flex;gap:12px;flex-wrap:wrap;margin-top:22px}
.result-box{margin-top:22px;background:var(--blush-2);border:1.5px solid var(--rose);border-radius:16px;padding:24px}
.result-box h3{margin:0 0 4px}
.result-box .stat{font-family:var(--serif);font-size:1.55rem;color:var(--rose-ink);margin-bottom:12px}
.progress{height:10px;background:rgba(154,95,87,.12);border-radius:999px;overflow:hidden}
.progress-bar{height:100%;border-radius:999px}
.atest .note{background:#fff;border-left:3px solid var(--rose-deep);padding:12px 16px;border-radius:8px;margin-top:14px;font-size:.96rem}
.atest details{margin-top:18px}
.atest summary{cursor:pointer;font-weight:700;color:var(--rose-ink)}
.atest details p{font-size:.95rem;margin:8px 0;color:var(--ink)}
.atest-src{font-size:.8rem;color:var(--muted);margin-top:16px;text-align:center}
  </style>

<!-- 1-2. ЗАГОЛОВОК + ЗАЧЕМ -->
<section class="hero">
  <div class="container" style="grid-template-columns:1fr;text-align:center;max-width:760px">
    <div>
      <span class="eyebrow">Бесплатно · 5 минут</span>
      <h1>Узнай свой тип<br>привязанности</h1>
      <p class="lead" style="margin-left:auto;margin-right:auto">Это то, как ты ведёшь себя в близости: бросаешься спасать, требуешь, замираешь или убегаешь. От типа привязанности зависит, почему вы ссоритесь именно так — и что с этим делать. 5 минут, и ты поймёшь про себя то, что объясняет годы отношений.</p>
      <a href="#test" class="btn btn-primary btn-lg">Начать тест →</a>
    </div>
  </div>
</section>

<!-- 3. ТЕСТ -->
<section class="section bg-cream2" id="test">
  <div class="container">
    <div class="center">
      <span class="eyebrow">Шаг 1</span>
      <h2>Пройди тест</h2>
      <hr class="rule center">
    </div>
    <div class="atest">
      <p class="scale-note">Шкала: 1 — совсем не про меня · 5 — очень про меня. 12 вопросов, отвечай честно — это для тебя.</p>
      <form id="testForm"></form>
      <div class="atest-btns">
        <button class="btn btn-primary" id="calcBtn" type="button">Посчитать мой тип →</button>
        <button class="btn btn-ghost" id="resetBtn" type="button">Сбросить</button>
      </div>
      <div id="result"></div>
      <details>
        <summary>Что такое типы привязанности?</summary>
        <p><strong>Надёжная (Якорь, ~50%):</strong> комфортно и в близости, и наедине с собой. Эмоции регулируются спокойно, конфликт не разрушает чувство безопасности.</p>
        <p><strong>Тревожная (Волна, ~20%):</strong> паника при отдалении, постоянная проверка «а как он ко мне сейчас», страх быть оставленной.</p>
        <p><strong>Избегающая (Остров, ~25%):</strong> дискомфорт от близости, желание отстраниться при «слишком близко», автономия ценится выше связи.</p>
        <p><strong>К надёжной можно прийти.</strong> Это реальный путь через работу над собой, а не врождённый приговор.</p>
      </details>
      <p class="atest-src">В основе — теория привязанности (Боулби), исследования Микулинцера и Шейвера, модель Таткина (PACT) и ЭФТ Сью Джонсон.</p>
    </div>
  </div>
</section>

<!-- 4-5. ЗАХВАТ + БОНУС -->
<section class="section">
  <div class="container">
    <div class="center">
      <span class="eyebrow">Шаг 2</span>
      <h2>Куда прислать результат + подарок</h2>
      <hr class="rule center">
      <p class="lead narrow">Оставь имя и контакт — пришлю развёрнутый разбор твоего типа и <strong>PDF-гайд «Какой у тебя тип привязанности и что с этим делать»</strong> в подарок.</p>
    </div>
    <form class="form" id="leadForm" style="margin-top:28px">
      <input type="text" name="website" id="lf_hp" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px;opacity:0;height:0;width:0">
      <div>
        <label for="name">Как тебя зовут</label>
        <input id="name" type="text" placeholder="Имя">
      </div>
      <div>
        <label for="contact">Email или Telegram</label>
        <input id="contact" type="text" placeholder="email@почта.ру или @username">
      </div>
      <label class="lead-consent" style="display:flex;gap:9px;align-items:flex-start;font-size:.84rem;color:var(--muted);font-weight:400;cursor:pointer;line-height:1.45">
        <input type="checkbox" id="lf_consent" style="margin-top:3px;width:auto;flex:0 0 auto">
        <span>Я согласна на обработку персональных данных и принимаю <a href="privacy.html" target="_blank" rel="noopener" style="color:var(--rose-ink);text-decoration:underline">политику конфиденциальности</a></span>
      </label>
      <button class="btn btn-primary btn-lg" type="submit" id="leadBtn">Получить результат + PDF →</button>
      <p class="note" id="leadMsg" style="display:none"></p>
    </form>
  </div>
</section>

<!-- 6. ЧТО ДАЛЬШЕ -->
<section class="section bg-blush">
  <div class="container narrow center">
    <span class="eyebrow">Что дальше</span>
    <h2>После теста</h2>
    <hr class="rule center">
    <p class="lead">Telegram-бот сразу пришлёт тебе результат и PDF-гайд. А дальше — без спама и продаж в лоб: время от времени буду делиться разборами и историями. Захочешь глубже — там и расскажу про курс «Отношения длиною в жизнь». Не захочешь — просто оставишь себе тест и гайд.</p>
    <div class="btn-row center" style="margin-top:10px">
      <a href="course.html" class="btn btn-ghost btn-lg">А что за курс «Отношения длиною в жизнь»?</a>
    </div>
  </div>
</section>

<!-- 7. ДРУГИЕ БЕСПЛАТНЫЕ ТЕСТЫ -->
<section class="section bg-cream2">
  <div class="container">
    <div class="center">
      <span class="eyebrow">Ещё бесплатно · без регистрации</span>
      <h2>Другие тесты об отношениях</h2>
      <hr class="rule center">
      <p class="lead narrow">Короткие тесты — про тебя, твой выбор и твою пару. Бесплатно, прямо на сайте.</p>
    </div>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(258px,1fr));gap:18px;margin-top:34px">
      <a href="https://test.ageeva.win/" class="card" data-goal="free_bigfive">
        <span class="ico">✶</span>
        <h3>Большая пятёрка — научный тест личности</h3>
        <p>120 вопросов · ~10 минут · профиль по 5 чертам и 30 граням. Пройди вдвоём с партнёром — и сравните.</p>
        <span class="more">Пройти тест →</span>
      </a>

      <a href="tests/attachment-triangle-test.html" class="card" data-goal="free_triangle">
        <span class="ico">△</span>
        <h3>Привязанность, выбор и роль</h3>
        <p>Как связаны твой тип, выбор партнёра и роль, в которую ты раз за разом попадаешь.</p>
        <span class="more">Пройти тест →</span>
      </a>
      <a href="tests/four-horsemen-test.html" class="card" data-goal="free_horsemen">
        <span class="ico">⚑</span>
        <h3>4 всадника (Готтман)</h3>
        <p>Критика, презрение, защита, отстранение — что разрушает вашу пару. Можно пройти вдвоём.</p>
        <span class="more">Пройти тест →</span>
      </a>
      <a href="tests/alpha-beta-adult-test.html" class="card" data-goal="free_alpha">
        <span class="ico">♂</span>
        <h3>Какой мужчина рядом</h3>
        <p>Альфа, бета или взрослый — и что твой выбор говорит о тебе.</p>
        <span class="more">Пройти тест →</span>
      </a>
      <a href="tests/erotic-profile-test.html" class="card" data-goal="free_erotic">
        <span class="ico">❦</span>
        <h3>Эротический профиль</h3>
        <p>Что включает твоё желание и близость — по идеям Эстер Перель.</p>
        <span class="more">Пройти тест →</span>
      </a>
      <a href="tests/narcissist-test.html" class="card" data-goal="free_narc">
        <span class="ico">◆</span>
        <h3>Нарцисс или тяжёлый характер?</h3>
        <p>Где заканчивается сложный характер и начинается нарциссизм. По работам Дурвасулы и Готтмана.</p>
        <span class="more">Пройти тест →</span>
      </a>
      <a href="tests/self-questionnaire.html" class="card" data-goal="free_self">
        <span class="ico">❤</span>
        <h3>Узнай себя — большой опросник</h3>
        <p>Подробный опросник, чтобы увидеть себя в отношениях со стороны: паттерны, реакции, зоны роста.</p>
        <span class="more">Пройти тест →</span>
      </a>
      <div id="dynTests" style="display:contents"></div>
    </div>
    <p class="center" style="margin-top:28px"><a href="tests/" class="btn btn-ghost" data-goal="free_all_tests">Все тесты об отношениях →</a></p>
  </div>
</section>

  <script is:inline slot="scripts">
(function(){
  var QUESTIONS = [
    {h:'anchor', q:'Мне комфортно и одной, и в близких отношениях'},
    {h:'anchor', q:'Я могу попросить о поддержке без чувства вины'},
    {h:'anchor', q:'Конфликт не разрушает моё чувство безопасности с партнёром'},
    {h:'anchor', q:'Я доверяю, что партнёр вернётся, если ушёл остыть'},
    {h:'wave',   q:'Когда партнёр не отвечает быстро — я начинаю тревожиться'},
    {h:'wave',   q:'Часто проверяю, как партнёр ко мне относится прямо сейчас'},
    {h:'wave',   q:'При охлаждении паникую и начинаю «дёргать» партнёра'},
    {h:'wave',   q:'Боюсь, что меня бросят, даже без объективных причин'},
    {h:'island', q:'Когда партнёр «слишком близко» — хочется отстраниться'},
    {h:'island', q:'Свободу и автономию ценю выше глубокой эмоциональной связи'},
    {h:'island', q:'Эмоциональные разговоры утомляют меня'},
    {h:'island', q:'В стрессе предпочитаю справляться одна, без помощи'}
  ];
  var LABELS = {anchor:'Надёжная (Якорь)', wave:'Тревожная (Волна)', island:'Избегающая (Остров)'};
  var COLORS = {anchor:'#5B9A78', wave:'#C9756E', island:'#B8946A'};
  window.shareAttach=function(){
    var t=window.__attachResult||'мой тип привязанности';
    var text='Мой тип привязанности — '+t+'. Прошла бесплатный тест у Валентины 🤍';
    var url='https://ageeva.win/free';
    if(navigator.share){ navigator.share({title:'Тип привязанности',text:text,url:url}).catch(function(){}); }
    else { window.open('https://t.me/share/url?url='+encodeURIComponent(url)+'&text='+encodeURIComponent(text),'_blank'); }
  };
  var form = document.getElementById('testForm');
  if(!form) return;
  QUESTIONS.forEach(function(item, i){
    var row = document.createElement('div');
    row.className = 'slider-q';
    row.innerHTML =
      '<div class="q">' + (i+1) + '. ' + item.q + '</div>' +
      '<div class="slider-row">' +
        '<span class="slider-min">не про меня</span>' +
        '<input type="range" min="1" max="5" value="3" data-h="' + item.h + '">' +
        '<span class="slider-val">3</span>' +
        '<span class="slider-max">очень про меня</span>' +
      '</div>';
    var inp = row.querySelector('input[type=range]');
    var val = row.querySelector('.slider-val');
    inp.dataset.touched = '0';
    inp.addEventListener('input', function(){
      val.textContent = inp.value; val.classList.remove('unset'); inp.dataset.touched = '1';
    });
    form.appendChild(row);
  });
  document.getElementById('calcBtn').addEventListener('click', function(){
    var sums={anchor:0,wave:0,island:0}, counts={anchor:0,wave:0,island:0};
    document.querySelectorAll('#testForm input[type=range]').forEach(function(r){
      sums[r.dataset.h]+=parseInt(r.value,10); counts[r.dataset.h]+=1;
    });
    var avgs={anchor:sums.anchor/counts.anchor, wave:sums.wave/counts.wave, island:sums.island/counts.island};
    var max='anchor',maxV=avgs.anchor;
    if(avgs.wave>maxV){max='wave';maxV=avgs.wave;}
    if(avgs.island>maxV){max='island';maxV=avgs.island;}
    window.__attachResult=LABELS[max];
    var html='<div class="result-box"><h3>Твой тип:</h3><div class="stat">'+LABELS[max]+'</div>';
    ['anchor','wave','island'].forEach(function(k){
      var pct=Math.round((avgs[k]-1)/4*100);
      html+='<div style="margin:14px 0;"><div style="display:flex;justify-content:space-between;font-weight:700;font-size:14px;"><span>'+LABELS[k]+'</span><span>'+pct+'%</span></div>';
      html+='<div class="progress"><div class="progress-bar" style="width:'+pct+'%;background:'+COLORS[k]+'"></div></div></div>';
    });
    var rec='';
    if(max==='anchor'){ rec='<strong>Надёжная привязанность.</strong> Это твой ресурс. Поддерживай тёплый контакт и ритуалы близости — и помогай партнёру (если он тревожный или избегающий) двигаться к этой же опоре.'; }
    else if(max==='wave'){ rec='<strong>Тревожная.</strong> Учись успокаивать себя сама (техника 5-4-3-2-1, дыхание 4-7-8) ДО того, как «дёргать» партнёра. Если партнёр избегающий — твоя тревога его пугает; вместо проверок скажи прямо: «мне нужно подтверждение».'; }
    else{ rec='<strong>Избегающая.</strong> Учись оставаться в контакте 20 минут, даже когда хочется уйти. Если партнёр тревожный — твой уход для него триггер; вместо исчезновения — «мне нужно 20 минут, я вернусь».'; }
    html+='<div class="note">'+rec+'</div>';
    html+='<div class="atest-btns"><a class="btn btn-primary cta-shine" href="/assets/pdf/tip-privyazannosti.pdf" target="_blank" rel="noopener" data-goal="pdf_download">📄 Скачать разбор (PDF)</a><a class="btn btn-ghost" href="https://t.me/ageevawin_bot?start=tip-privyazannosti" target="_blank" rel="noopener" data-goal="tg_pdf">📲 В Telegram</a><a class="btn btn-primary" href="course.html" data-goal="test_to_course">Разобрать на курсе →</a><button type="button" class="btn btn-ghost" onclick="shareAttach()" data-goal="share_result">Поделиться →</button></div></div>';
    html+='<div class="result-box" style="margin-top:18px;background:#fff"><h3>Для пары: ловушка «тревожный + избегающий»</h3><p style="font-size:14px;color:var(--muted);margin:8px 0 0;">Самый частый цикл: одна требует близости — другой отступает — первая паникует и требует ещё — второй отступает дальше. Это «преследователь — отстраняющийся» (Сью Джонсон, ЭФТ). Выход: оба учатся <strong>называть цикл</strong>, а не воевать в нём.</p></div>';
    var box=document.getElementById('result');
    box.innerHTML=html; box.scrollIntoView({behavior:'smooth'});
    if(window.track){ try{ track('test_complete'); }catch(e){} }
  });
  document.getElementById('resetBtn').addEventListener('click', function(){
    document.querySelectorAll('#testForm input[type=range]').forEach(function(r){ r.value=3; r.dataset.touched='0'; });
    document.querySelectorAll('#testForm .slider-val').forEach(function(v){ v.textContent='3'; v.classList.remove('unset'); });
    document.getElementById('result').innerHTML='';
  });
})();
  </script>
  <script is:inline slot="scripts">
(function(){
  var form=document.getElementById('leadForm');
  if(!form) return;
  var msg=document.getElementById('leadMsg'), btn=document.getElementById('leadBtn');
  function show(t,ok){ msg.style.display='block'; msg.textContent=t; msg.style.color=ok?'#3F8F62':'#C0524B'; msg.style.background=ok?'#EAF5EE':'#FBEFEE'; msg.style.borderColor=ok?'#BFE3CC':'#F0CBC7'; }
  form.addEventListener('submit', function(e){
    e.preventDefault();
    if(document.getElementById('lf_hp').value){ return; }
    var name=(document.getElementById('name').value||'').trim();
    var contact=(document.getElementById('contact').value||'').trim();
    if(contact.length<3){ show('Оставь email или Telegram — иначе мне некуда прислать разбор.',false); return; }
    if(!document.getElementById('lf_consent').checked){ show('Отметь согласие на обработку данных — без него не могу принять заявку.',false); return; }
    btn.disabled=true; var old=btn.textContent; btn.textContent='Отправляю…';
    var send = window.SB ? SB.rpc('valya_lead_add',{p_name:name,p_contact:contact,p_source:'free-test',p_result:window.__attachResult||null,p_consent:true}) : Promise.reject('no-sb');
    send.then(function(){
      form.querySelectorAll('input,button,label,div').forEach(function(el){ el.style.display='none'; });
      show('Спасибо'+(name?(', '+name):'')+'! Твой разбор готов — скачивай. Копию пришлю и на твой контакт.',true);
      msg.style.fontSize='1.05rem'; msg.style.padding='16px 18px';
      msg.innerHTML += '<br><br><a class="btn btn-primary cta-shine" href="/assets/pdf/tip-privyazannosti.pdf" target="_blank" rel="noopener" data-goal="pdf_download">📄 Скачать PDF-разбор «Тип привязанности»</a>';
    }).catch(function(){
      btn.disabled=false; btn.textContent=old;
      show('Не получилось отправить. Напиши мне в Telegram — кнопка справа внизу.',false);
    });
  });
})();
  </script>
  <script src="/assets/test-icons.js" defer is:inline slot="scripts"></script>
  <script src="/assets/tests-list.js" defer is:inline slot="scripts"></script>
</Layout>
